{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ee440887baf7dfdfc41b84f0f07af31b05ee6b1a"
         :deps/root "lib/kotoba.text"}}
 ;; Frontend deps (shadow-cljs :cljs alias). appkit transitively pulls
 ;; kotoba-ui → liquid-glass-ui → shitsuke — same convention as
 ;; orgs/kotoba-lang/murakumo-studio/deps.edn. local/root path is relative
 ;; to this repo's checkout location: the shared checkout
 ;; orgs/cloud-itonami/app-resource-flow and the worktree
 ;; orgs/cloud-itonami/_wt-app-resource-flow sit at the same depth, so
 ;; ../../kotoba-lang/appkit resolves in both (proven pattern:
 ;; cloud-itonami/rare-earth, cloud-itonami/app-kaigo).
 :aliases
 {:cljs
  {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.20"}
                reagent/reagent {:mvn/version "1.2.0"}
                io.github.kotoba-lang/appkit
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.appkit"}}}}}
